# App
APP_NAME="RCCG Praise Embassy API"
ENVIRONMENT=development
DEBUG=true

# Security — generate with: openssl genrsa -out private.pem 2048
SECRET_KEY=change-me-in-production
PRIVATE_KEY_PATH=app/core/keys/private.pem
PUBLIC_KEY_PATH=app/core/keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rccg_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET_NAME=rccg-praise-embassy-media
CLOUDFRONT_DOMAIN=

# Payment
PAYSTACK_SECRET_KEY=sk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
