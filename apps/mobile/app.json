{
  "expo": {
    "name": "RCCG Praise Embassy",
    "slug": "rccg-praise-embassy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rccgpe",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rccgpe.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan QR codes for attendance check-in.",
        "NSPhotoLibraryUsageDescription": "Photo library access is used to update your profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a237e"
      },
      "package": "com.rccgpe.app",
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:8000/api/v1",
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    },
    "plugins": []
  }
}
